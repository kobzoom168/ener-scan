+"""
+Alert state machine — แจ้งเตือนทรัพยากร/ข้อผิดพลาดแบบ "สถานะ" ครั้งเดียวต่อเหตุ (Codex/กบ 19 ต.ค. 2026)
+
+ทำไม: health_check (*/30) และ monitor_check (*/10) เคยตรวจดิสก์ลูกเดียวกันแล้วต่างคนต่างส่ง → เหตุเดียวซ้ำ 2 ทาง
+กติกา:
+  - ระดับ ok < warn < high < critical ต่อ topic (เกณฑ์เดิม 80/85 คงไว้ เพิ่ม critical 90 เป็นระดับใหม่ ไม่ขยับของเดิม)
+  - ส่งเมื่อ: ระดับเพิ่ม (escalate) · กลับ ok (recover) · ระดับลดแต่ยังไม่ ok (deescalate) · ระดับเท่าเดิม = reminder ตามระดับ (warn 6 ชม. / high 2 ชม. / critical 30 นาที) — ไม่เงียบ ไม่ปิด alert
+  - ล็อกร่วม: asyncio.Lock ต่อ topic (job ในโปรเซสเดียว) + claim ใน SQLite (TTL 2 นาที, BEGIN IMMEDIATE) กันหลายโปรเซส → ผู้ส่งมีคนเดียว
+  - บันทึก state/last_sent **หลัง Telegram ส่งสำเร็จเท่านั้น** · ส่งล้ม = ไม่บันทึก → รอบถัดไปลองใหม่ · state อยู่ใน SQLite (memories) → restart ไม่ลืม
+  - app_error: แยกตาม "ลายเซ็น" ของ error (hash ของบรรทัดที่ normalize แล้ว) → error ใหม่ไม่ถูก cooldown ของ error เก่าบัง · **ไม่แจ้ง recovery เอง** (ไม่พบ error ใน 15 นาที ≠ บริการกลับมา)
+  - ข้อความ: [ener-ai][topic][level] เวลาไทย · ค่าจริง · ตั้งแต่เมื่อไร · (reminder) · ข้อความ/บรรทัด error ผ่าน redact() ก่อนเสมอ
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import re
+from collections.abc import Awaitable, Callable
+from datetime import datetime, timedelta
+from zoneinfo import ZoneInfo
+
+from app.core.database import get_db
+
+_BANGKOK = ZoneInfo("Asia/Bangkok")
+LEVELS: tuple[str, ...] = ("ok", "warn", "high", "critical")
+THRESHOLDS: dict[str, dict[str, float]] = {
+    "disk": {"warn": 80, "high": 85, "critical": 90},   # 80/85 = เกณฑ์เดิมของ health_check/monitor_check
+    "cpu": {"high": 85, "critical": 95},
+    "ram": {"high": 90, "critical": 95},
+}
+REMINDER: dict[str, timedelta] = {"warn": timedelta(hours=6), "high": timedelta(hours=2), "critical": timedelta(minutes=30)}
+APP_ERROR_REMINDER = timedelta(hours=6)
+CLAIM_TTL = timedelta(minutes=2)
+SYSTEM_TAG = "ener-ai"
+THAI_MONTHS = ["ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."]
+
+Sender = Callable[[str], Awaitable[bool]]
+_locks: dict[str, asyncio.Lock] = {}
+
+
+def _lock(topic: str) -> asyncio.Lock:
+    if topic not in _locks:
+        _locks[topic] = asyncio.Lock()
+    return _locks[topic]
+
+
+def _now() -> datetime:
+    return datetime.now(_BANGKOK)
+
+
+def fmt_time(dt: datetime) -> str:
+    dt = dt.astimezone(_BANGKOK)
+    return f"{dt.day} {THAI_MONTHS[dt.month - 1]} {dt:%H:%M}"
+
+
+def _parse(iso: str | None) -> datetime | None:
+    if not iso:
+        return None
+    try:
+        dt = datetime.fromisoformat(str(iso))
+        return dt if dt.tzinfo else dt.replace(tzinfo=_BANGKOK)
+    except Exception:
+        return None
+
+
+# ───────── redaction (ก่อนส่งทุกข้อความที่มีเนื้อ log) ─────────
+_REDACT_PATTERNS = [
+    (re.compile(r"\b\d{6,}:[A-Za-z0-9_-]{30,}"), "<telegram-token>"),
+    (re.compile(r"\bsk-[A-Za-z0-9_-]{10,}"), "<api-key>"),
+    (re.compile(r"\b(?:Bearer|bearer)\s+[A-Za-z0-9._\-]{8,}"), "Bearer <token>"),
+    (re.compile(r"\b(api[_-]?key|token|secret|password|passwd|authorization)\s*[=:]\s*\S+", re.I), r"\1=<redacted>"),
+    (re.compile(r"\bU[0-9a-f]{32}\b"), lambda m: m.group(0)[:8] + "…"),          # LINE userId → prefix 8
+    (re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"), "<email>"),
+    (re.compile(r"\b0[0-9]{8,9}\b"), "<phone>"),
+    (re.compile(r"\b[0-9a-f]{40,}\b"), "<hex>"),
+    (re.compile(r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"), "<jwt>"),
+]
+
+
+def redact(text: str) -> str:
+    out = str(text or "")
+    for pat, rep in _REDACT_PATTERNS:
+        out = pat.sub(rep, out)
+    return out
+
+
+# ───────── level / decision (pure) ─────────
+def level_for(topic: str, value: float) -> str:
+    thresholds = THRESHOLDS.get(topic, {})
+    level = "ok"
+    for lv in ("warn", "high", "critical"):
+        t = thresholds.get(lv)
+        if t is not None and value >= t:
+            level = lv
+    return level
+
+
+def decide(prev: dict | None, level: str, now: datetime, reminder: dict[str, timedelta] | None = None) -> dict:
+    """ตัดสินว่าต้องส่งไหมและเพราะอะไร — ไม่แตะ DB (ทดสอบได้ตรง ๆ)"""
+    reminder = reminder or REMINDER
+    prev_level = (prev or {}).get("level", "ok")
+    if prev_level not in LEVELS:
+        prev_level = "ok"
+    same = prev_level == level
+    since = (prev or {}).get("since") if same and prev else now.isoformat()
+    last_sent = _parse((prev or {}).get("last_sent")) if prev else None
+    kind = None
+    if LEVELS.index(level) > LEVELS.index(prev_level):
+        kind = "escalate"
+    elif level == "ok" and prev_level != "ok":
+        kind = "recover"
+    elif level != "ok" and LEVELS.index(level) < LEVELS.index(prev_level):
+        kind = "deescalate"
+    elif level != "ok" and same:
+        gap = reminder.get(level, timedelta(hours=6))
+        if last_sent is None or now - last_sent >= gap:
+            kind = "reminder"
+    return {"send": kind is not None, "kind": kind, "level": level, "prev_level": prev_level, "since": since or now.isoformat()}
+
+
+# ───────── persistence (SQLite memories) ─────────
+def _key(topic: str) -> str:
+    return f"alert_state_{topic}"
+
+
+async def load_state(topic: str) -> dict | None:
+    async with get_db() as db:
+        cur = await db.execute("SELECT value FROM memories WHERE key = ?", (_key(topic),))
+        row = await cur.fetchone()
+    if not row:
+        return None
+    try:
+        return json.loads(row["value"])
+    except Exception:
+        return None
+
+
+async def save_state(topic: str, state: dict) -> None:
+    async with get_db() as db:
+        await db.execute(
+            """INSERT INTO memories (key, value, tag) VALUES (?, ?, 'alert_state')
+               ON CONFLICT(key) DO UPDATE SET value = excluded.value, tag = 'alert_state', updated_at = CURRENT_TIMESTAMP""",
+            (_key(topic), json.dumps(state, ensure_ascii=False)),
+        )
+        await db.commit()
+
+
+async def _claim(topic: str, now: datetime) -> bool:
+    """claim ข้าม process: แถว alert_claim_<topic> ถ้าหมดอายุ (TTL) หรือไม่มี → ยึดได้ · ใช้ BEGIN IMMEDIATE กัน race"""
+    key = f"alert_claim_{topic}"
+    async with get_db() as db:
+        await db.execute("BEGIN IMMEDIATE")
+        try:
+            cur = await db.execute("SELECT value FROM memories WHERE key = ?", (key,))
+            row = await cur.fetchone()
+            held = _parse(row["value"]) if row else None
+            if held and now - held < CLAIM_TTL:
+                await db.execute("ROLLBACK")
+                return False
+            await db.execute(
+                """INSERT INTO memories (key, value, tag) VALUES (?, ?, 'alert_claim')
+                   ON CONFLICT(key) DO UPDATE SET value = excluded.value, tag = 'alert_claim', updated_at = CURRENT_TIMESTAMP""",
+                (key, now.isoformat()),
+            )
+            await db.execute("COMMIT")
+            return True
+        except Exception:
+            try:
+                await db.execute("ROLLBACK")
+            except Exception:
+                pass
+            raise
+
+
+async def _release(topic: str) -> None:
+    async with get_db() as db:
+        await db.execute("DELETE FROM memories WHERE key = ?", (f"alert_claim_{topic}",))
+        await db.commit()
+
+
+# ───────── message ─────────
+_ICON = {"escalate": "🔴", "reminder": "🟠", "deescalate": "🟡", "recover": "✅"}
+_KIND_TH = {"escalate": "ระดับเพิ่ม", "reminder": "ยังคงอยู่ (เตือนซ้ำตามรอบ)", "deescalate": "ระดับลดลง แต่ยังไม่ปกติ", "recover": "กลับสู่ปกติ"}
+
+
+def format_message(topic: str, decision: dict, value: float | None, now: datetime, details: str = "") -> str:
+    level = decision["level"]
+    kind = decision["kind"]
+    since = _parse(decision.get("since"))
+    parts = [f"[{SYSTEM_TAG}][{topic}][{level}] {fmt_time(now)} · {_ICON.get(kind, '')} {_KIND_TH.get(kind, kind)}"]
+    if value is not None:
+        parts.append(f"ค่า {value:.0f}%" + (f" (ก่อนหน้า: {decision['prev_level']})" if kind != "reminder" else ""))
+    if since and kind != "recover":
+        parts.append(f"ตั้งแต่ {fmt_time(since)}")
+    if level in REMINDER and kind != "recover":
+        gap = REMINDER[level]
+        parts.append(f"เตือนซ้ำทุก {int(gap.total_seconds() // 3600)} ชม." if gap >= timedelta(hours=1) else f"เตือนซ้ำทุก {int(gap.total_seconds() // 60)} นาที")
+    head = " · ".join(parts)
+    body = redact(details).strip()
+    return f"{head}\n{body}" if body else head
+
+
+# ───────── public API ─────────
+async def check_and_notify(
+    topic: str,
+    value: float,
+    send: Sender,
+    *,
+    details: str | Callable[[], str] | None = None,
+    now: datetime | None = None,
+) -> dict:
+    """ประเมินค่า → ส่งเมื่อสถานะเปลี่ยน/ถึงรอบ reminder · บันทึกเฉพาะเมื่อส่งสำเร็จ · คืน {sent, kind, level, reason}"""
+    now = now or _now()
+    async with _lock(topic):
+        if not await _claim(topic, now):
+            return {"sent": False, "reason": "claimed_by_other_process", "level": level_for(topic, value)}
+        try:
+            prev = await load_state(topic)
+            level = level_for(topic, value)
+            d = decide(prev, level, now)
+            if not d["send"]:
+                # ค่าเปลี่ยนแต่ระดับเดิม/ok: อัปเดตค่าล่าสุดไว้ดู (ไม่แตะ last_sent)
+                if prev and prev.get("level") == level and prev.get("value") != value:
+                    await save_state(topic, {**prev, "value": value})
+                return {"sent": False, "reason": "no_change", "level": level, "prev_level": d["prev_level"]}
+            detail_text = details() if callable(details) else (details or "")
+            text = format_message(topic, d, value, now, detail_text)
+            ok = False
+            try:
+                ok = bool(await send(text))
+            except Exception:
+                ok = False
+            if not ok:
+                return {"sent": False, "reason": "send_failed_retry_next_run", "kind": d["kind"], "level": level}
+            await save_state(topic, {"level": level, "value": value, "since": d["since"], "last_sent": now.isoformat(), "last_kind": d["kind"]})
+            return {"sent": True, "kind": d["kind"], "level": level, "prev_level": d["prev_level"], "text": text}
+        finally:
+            await _release(topic)
+
+
+def error_signature(line: str) -> tuple[str, str]:
+    """(topic, ข้อความลายเซ็น) — ตัด timestamp/ตัวเลข/hex ให้ error ชนิดเดียวกันรวมกัน แต่ชนิดต่างกันแยกกัน"""
+    s = re.sub(r"^\S*\d{4}-\d{2}-\d{2}T[\d:.]+Z?\s*", "", str(line or "").strip())
+    s = redact(s)
+    norm = re.sub(r"0x[0-9a-f]+|\b\d+\b", "#", s.lower())
+    norm = re.sub(r"\s+", " ", norm)[:160]
+    digest = hashlib.sha1(norm.encode("utf-8")).hexdigest()[:10]
+    return f"app_error:{digest}", s[:160]
+
+
+async def report_app_error(line: str, send: Sender, *, excerpt: str = "", now: datetime | None = None, container: str = "ener-ai") -> dict:
+    """error จาก log ล่าสุด: แจ้งครั้งแรกทันที · ซ้ำชนิดเดิม = reminder ทุก 6 ชม. · ชนิดใหม่ไม่ถูกบัง · ไม่มี recovery อัตโนมัติ"""
+    now = now or _now()
+    topic, sig = error_signature(line)
+    async with _lock(topic):
+        if not await _claim(topic, now):
+            return {"sent": False, "reason": "claimed_by_other_process", "topic": topic}
+        try:
+            prev = await load_state(topic)
+            d = decide(prev, "high", now, reminder={"high": APP_ERROR_REMINDER})
+            if not d["send"]:
+                return {"sent": False, "reason": "no_change", "topic": topic}
+            since = _parse(d["since"]) or now
+            text = (
+                f"[{SYSTEM_TAG}][app_error][high] {fmt_time(now)} · {'🔴 พบ error ใหม่' if d['kind'] == 'escalate' else '🟠 error เดิมยังพบอยู่ (เตือนซ้ำทุก 6 ชม.)'}\n"
+                f"container: {container} · ครั้งแรก {fmt_time(since)}\n"
+                f"{sig}\n"
+                + (f"ตัวอย่าง log:\n{redact(excerpt).strip()[:600]}\n" if excerpt else "")
+                + "หมายเหตุ: ไม่พบ error นี้ในรอบต่อไป ≠ บริการกลับมาใช้ได้ — ต้องตรวจยืนยันเอง (ไม่มีการแจ้ง recovery อัตโนมัติ)"
+            )
+            ok = False
+            try:
+                ok = bool(await send(text))
+            except Exception:
+                ok = False
+            if not ok:
+                return {"sent": False, "reason": "send_failed_retry_next_run", "topic": topic}
+            await save_state(topic, {"level": "high", "signature": sig, "since": d["since"], "last_sent": now.isoformat(), "last_kind": d["kind"]})
+            return {"sent": True, "kind": d["kind"], "topic": topic, "text": text}
+        finally:
+            await _release(topic)
+
+
+def extract_error_lines(log_text: str, max_items: int = 5) -> list[tuple[str, str]]:
+    """จาก log ที่กรองแล้ว → [(บรรทัด error หลัก, excerpt 3 บรรทัดรอบ ๆ)] ไม่ซ้ำลายเซ็น · ข้าม traceback frames ('  File ...')"""
+    lines = [l for l in str(log_text or "").split("\n") if l.strip()]
+    out: list[tuple[str, str]] = []
+    seen: set[str] = set()
+    for i, line in enumerate(lines):
+        body = re.sub(r"^\S*\d{4}-\d{2}-\d{2}T[\d:.]+Z?\s*", "", line.strip())
+        if body.startswith(("File ", "Traceback", "The above exception", "During handling")) or body.startswith(("raise ", "await ", "return ")):
+            continue
+        if not re.search(r"error|exception|critical|failed", body, re.I):
+            continue
+        topic, _ = error_signature(line)
+        if topic in seen:
+            continue
+        seen.add(topic)
+        excerpt = "\n".join(lines[max(0, i - 1): i + 2])
+        out.append((line, excerpt))
+        if len(out) >= max_items:
+            break
+    return out
