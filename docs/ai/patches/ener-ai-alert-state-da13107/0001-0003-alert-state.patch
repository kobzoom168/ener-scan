+++ b/tests/test_alert_state.py
@@ -0,0 +1,203 @@
+"""alert_state (19 ต.ค. 2026): escalate/recover/reminder · ส่งล้มไม่บันทึก (retry) · restart ไม่ลืม · สอง job พร้อมกันส่งครั้งเดียว · app_error แยกลายเซ็น ไม่ recovery เอง · redact · integration static"""
+import asyncio
+import os
+import re
+import tempfile
+import unittest
+from contextlib import asynccontextmanager
+from datetime import datetime, timedelta
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import aiosqlite
+
+from app.agents import alert_state as A
+
+BKK = ZoneInfo("Asia/Bangkok")
+T0 = datetime(2026, 10, 19, 12, 59, tzinfo=BKK)
+
+
+def _tmp_db():
+    fd, path = tempfile.mkstemp(suffix=".db"); os.close(fd)
+
+    @asynccontextmanager
+    async def get_db():
+        async with aiosqlite.connect(path, timeout=30.0) as db:
+            db.row_factory = aiosqlite.Row
+            await db.execute("PRAGMA journal_mode=WAL")
+            await db.execute("PRAGMA busy_timeout=10000")
+            await db.execute("CREATE TABLE IF NOT EXISTS memories (id INTEGER PRIMARY KEY AUTOINCREMENT, key TEXT UNIQUE NOT NULL, value TEXT NOT NULL, tag TEXT DEFAULT 'general', updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)")
+            yield db
+    return get_db, path
+
+
+class Sender:
+    def __init__(self, fail_times=0, delay=0.0):
+        self.sent = []; self.fail_times = fail_times; self.delay = delay; self.calls = 0
+
+    async def __call__(self, text):
+        self.calls += 1
+        if self.delay:
+            await asyncio.sleep(self.delay)
+        if self.fail_times > 0:
+            self.fail_times -= 1
+            raise RuntimeError("telegram down")
+        self.sent.append(text)
+        return True
+
+
+class AlertStateTests(unittest.TestCase):
+    def setUp(self):
+        self.get_db, self.path = _tmp_db()
+        self._orig = A.get_db; A.get_db = self.get_db; A._locks.clear()
+
+    def tearDown(self):
+        A.get_db = self._orig
+        for suffix in ("", "-wal", "-shm"):
+            try: os.remove(self.path + suffix)
+            except FileNotFoundError: pass
+
+    def run_async(self, coro):
+        return asyncio.run(coro)
+
+    def test_levels_and_decide(self):
+        self.assertEqual([A.level_for("disk", v) for v in (10, 80, 84.9, 85, 89, 90)], ["ok", "warn", "warn", "high", "high", "critical"])
+        self.assertEqual(A.level_for("cpu", 50), "ok"); self.assertEqual(A.level_for("unknown", 99), "ok")
+        d = A.decide(None, "warn", T0); self.assertEqual((d["send"], d["kind"]), (True, "escalate"))
+        prev = {"level": "warn", "since": T0.isoformat(), "last_sent": T0.isoformat()}
+        self.assertFalse(A.decide(prev, "warn", T0 + timedelta(hours=1))["send"], "ระดับเดิม ก่อนครบรอบ = ไม่ส่ง")
+        self.assertEqual(A.decide(prev, "warn", T0 + timedelta(hours=6))["kind"], "reminder")
+        self.assertEqual(A.decide(prev, "high", T0 + timedelta(minutes=1))["kind"], "escalate")
+        self.assertEqual(A.decide({"level": "high", "since": "x", "last_sent": T0.isoformat()}, "warn", T0 + timedelta(minutes=1))["kind"], "deescalate")
+        self.assertEqual(A.decide(prev, "ok", T0 + timedelta(minutes=1))["kind"], "recover")
+        self.assertFalse(A.decide({"level": "ok"}, "ok", T0)["send"])
+
+    def test_escalate_reminder_recover_persisted(self):
+        s = Sender()
+        async def run():
+            r1 = await A.check_and_notify("disk", 86, s, now=T0, details="root fs ใช้ 61/75 GB")
+            r2 = await A.check_and_notify("disk", 86, s, now=T0 + timedelta(minutes=30))   # job อีกตัว 30 นาทีถัดมา
+            r3 = await A.check_and_notify("disk", 87, s, now=T0 + timedelta(hours=2))      # reminder high ทุก 2 ชม.
+            r4 = await A.check_and_notify("disk", 91, s, now=T0 + timedelta(hours=2, minutes=10))  # critical
+            r5 = await A.check_and_notify("disk", 70, s, now=T0 + timedelta(hours=3))      # recover
+            r6 = await A.check_and_notify("disk", 70, s, now=T0 + timedelta(hours=4))
+            return r1, r2, r3, r4, r5, r6
+        r1, r2, r3, r4, r5, r6 = self.run_async(run())
+        self.assertEqual([r["sent"] for r in (r1, r2, r3, r4, r5, r6)], [True, False, True, True, True, False])
+        self.assertEqual([r.get("kind") for r in (r1, r3, r4, r5)], ["escalate", "reminder", "escalate", "recover"])
+        self.assertEqual(r2["reason"], "no_change")
+        self.assertTrue(s.sent[0].startswith("[ener-ai][disk][high] 19 ต.ค. 12:59 · 🔴 ระดับเพิ่ม"), s.sent[0])
+        self.assertIn("ค่า 86%", s.sent[0]); self.assertIn("root fs ใช้ 61/75 GB", s.sent[0]); self.assertIn("เตือนซ้ำทุก 2 ชม.", s.sent[0])
+        self.assertIn("[disk][critical]", s.sent[2]); self.assertIn("เตือนซ้ำทุก 30 นาที", s.sent[2])
+        self.assertIn("[disk][ok]", s.sent[3]); self.assertIn("✅ กลับสู่ปกติ", s.sent[3])
+
+    def test_send_failure_keeps_state_and_retries(self):
+        s = Sender(fail_times=1)
+        async def run():
+            r1 = await A.check_and_notify("disk", 86, s, now=T0)
+            st = await A.load_state("disk")
+            r2 = await A.check_and_notify("disk", 86, s, now=T0 + timedelta(minutes=10))
+            return r1, st, r2
+        r1, st, r2 = self.run_async(run())
+        self.assertFalse(r1["sent"]); self.assertEqual(r1["reason"], "send_failed_retry_next_run")
+        self.assertIsNone(st, "ส่งล้ม = ไม่บันทึก last_sent/level")
+        self.assertTrue(r2["sent"]); self.assertEqual(r2["kind"], "escalate"); self.assertEqual(len(s.sent), 1)
+        self.assertEqual(self.run_async(A.load_state("disk"))["level"], "high")
+
+    def test_restart_does_not_forget(self):
+        s = Sender()
+        self.run_async(A.check_and_notify("disk", 86, s, now=T0))
+        A._locks.clear()  # จำลอง restart โปรเซส (in-memory หาย, SQLite อยู่)
+        r = self.run_async(A.check_and_notify("disk", 86, s, now=T0 + timedelta(minutes=20)))
+        self.assertFalse(r["sent"]); self.assertEqual(len(s.sent), 1)
+        r2 = self.run_async(A.check_and_notify("disk", 86, s, now=T0 + timedelta(hours=2)))
+        self.assertTrue(r2["sent"]); self.assertEqual(r2["kind"], "reminder")
+
+    def test_two_jobs_concurrently_send_once(self):
+        s = Sender(delay=0.05)
+        async def run():
+            return await asyncio.gather(
+                A.check_and_notify("disk", 86, s, now=T0),
+                A.check_and_notify("disk", 86, s, now=T0),
+                A.check_and_notify("disk", 86, s, now=T0 + timedelta(seconds=1)),
+            )
+        rs = self.run_async(run())
+        self.assertEqual(sum(1 for r in rs if r["sent"]), 1, rs); self.assertEqual(len(s.sent), 1)
+
+    def test_cross_process_claim(self):
+        s = Sender()
+        async def run():
+            ok = await A._claim("disk", T0); again = await A._claim("disk", T0 + timedelta(seconds=30)); expired = await A._claim("disk", T0 + timedelta(minutes=3))
+            await A._release("disk")
+            return ok, again, expired
+        ok, again, expired = self.run_async(run())
+        self.assertEqual((ok, again, expired), (True, False, True))
+        A._locks.clear()
+        async def run2():
+            await A._claim("disk", T0)  # โปรเซสอื่นถือ claim อยู่
+            r = await A.check_and_notify("disk", 86, s, now=T0 + timedelta(seconds=10))
+            await A._release("disk")
+            return r
+        r = self.run_async(run2())
+        self.assertEqual(r["reason"], "claimed_by_other_process"); self.assertEqual(len(s.sent), 0)
+
+    def test_app_error_signatures_and_no_recovery(self):
+        s = Sender()
+        feather = '2026-10-19T02:00:02.059Z RuntimeError: Featherless request failed: HTTP 403: {"error":{"message":"You do not have an active subscription"}}'
+        locked = "2026-10-19T02:05:00.000Z sqlite3.OperationalError: database is locked"
+        async def run():
+            r1 = await A.report_app_error(feather, s, excerpt=feather, now=T0)
+            r2 = await A.report_app_error(feather.replace("02:00:02.059", "02:30:00.000"), s, now=T0 + timedelta(minutes=30))  # ชนิดเดิม → ไม่ส่ง
+            r3 = await A.report_app_error(locked, s, now=T0 + timedelta(minutes=31))                                         # ชนิดใหม่ → ส่ง ไม่ถูกบัง
+            r4 = await A.report_app_error(feather, s, now=T0 + timedelta(hours=6))                                           # reminder 6 ชม.
+            return r1, r2, r3, r4
+        r1, r2, r3, r4 = self.run_async(run())
+        self.assertEqual([r["sent"] for r in (r1, r2, r3, r4)], [True, False, True, True])
+        self.assertNotEqual(r1["topic"], r3["topic"]); self.assertEqual(r1["topic"], r4["topic"])
+        self.assertIn("[ener-ai][app_error][high]", s.sent[0]); self.assertIn("🔴 พบ error ใหม่", s.sent[0]); self.assertIn("Featherless request failed: HTTP 403", s.sent[0])
+        self.assertIn("ไม่พบ error นี้ในรอบต่อไป ≠ บริการกลับมาใช้ได้", s.sent[0])
+        self.assertIn("error เดิมยังพบอยู่", s.sent[2])
+        # ไม่มี API ใดส่ง recovery ของ app_error
+        self.assertFalse(hasattr(A, "report_app_error_recovered"))
+        self.assertEqual(A.decide({"level": "high", "last_sent": T0.isoformat(), "since": T0.isoformat()}, "high", T0 + timedelta(hours=1), reminder={"high": A.APP_ERROR_REMINDER})["send"], False)
+
+    def test_extract_error_lines_skips_frames_and_dedupes(self):
+        log = "\n".join([
+            "2026-10-19T02:00:02.0Z Traceback (most recent call last):",
+            '2026-10-19T02:00:02.0Z   File "/app/x.py", line 10, in f',
+            "2026-10-19T02:00:02.0Z     raise RuntimeError(f\"Featherless request failed: {detail}\") from exc",
+            "2026-10-19T02:00:02.0Z RuntimeError: Featherless request failed: HTTP 403: no active subscription id=12345",
+            "2026-10-19T02:00:02.1Z The above exception was the direct cause of the following exception:",
+            "2026-10-19T02:00:02.2Z RuntimeError: Featherless request failed: HTTP 403: no active subscription id=99999",
+            "2026-10-19T02:05:00.0Z sqlite3.OperationalError: database is locked",
+        ])
+        items = A.extract_error_lines(log)
+        self.assertEqual(len(items), 2, items)
+        self.assertIn("Featherless request failed", items[0][0]); self.assertIn("database is locked", items[1][0])
+        self.assertIn("RuntimeError: Featherless", items[0][1])
+
+    def test_redact(self):
+        raw = "token=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA key sk-abcdefghijklmnop Bearer abcdefghij12 user Ufe02fffb43200f2a32eabb919130ed9b mail a@b.co tel 0812345678 api_key=XYZ"
+        out = A.redact(raw)
